<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="questlog" Manufacturer="ProportanilityConstant" Version="0.1.0"
           UpgradeCode="6f1c2d0e-4b7a-4a43-9d0e-3b9c2f6a1e55" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of questlog is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AppIcon" SourceFile="..\assets\windows\questlog.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />
    <ui:WixUI Id="WixUI_Minimal" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="questlog">
        <Component Id="MainExe" Guid="*">
          <File Id="QuestlogExe" Source="$(var.ExePath)" KeyPath="yes" />
          <Environment Id="PathEntry" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="yes" Permanent="no" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenu" Name="questlog">
        <Component Id="MenuShortcut" Guid="*">
          <Shortcut Id="QuestlogShortcut" Name="questlog" Description="Repo audit as a pixel-RPG sheet"
                    Target="[System64Folder]cmd.exe" Icon="AppIcon" WorkingDirectory="PersonalFolder"
                    Arguments="/k &quot;&quot;[INSTALLFOLDER]questlog.exe&quot; --help&quot;" />
          <RemoveFolder Id="RemoveAppMenu" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\questlog" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="questlog" Level="1">
      <ComponentRef Id="MainExe" />
      <ComponentRef Id="MenuShortcut" />
    </Feature>
  </Package>
</Wix>
